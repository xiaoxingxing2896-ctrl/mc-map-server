---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="编辑 Wiki">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="wiki-editor" id="wikiEditor">
    <header class="we-head">
      <div class="we-head-copy">
        <span class="section-tag">WIKI CMS</span>
        <h1>编辑 Wiki</h1>
        <p>不用碰仓库：改文字、加页面、建栏目、传图片。保存后提交到 GitHub，约 1–2 分钟自动部署生效。</p>
      </div>
      <a class="we-btn we-back" href="/wiki/">← 返回 Wiki</a>
    </header>

    <section id="gate" class="we-card we-gate" aria-labelledby="gateTitle" hidden>
      <div class="we-gate-mark" aria-hidden="true">🔒</div>
      <h2 id="gateTitle"></h2>
      <p id="gateText"></p>
      <div class="we-gate-actions" id="gateActions"></div>
    </section>

    <section id="loadingPane" class="we-card we-loading" aria-live="polite">
      <span class="we-spinner" aria-hidden="true"></span>
      <p>正在确认登录状态…</p>
    </section>

    <div id="app" class="we-grid" hidden>
      <aside class="we-card we-side" aria-label="Wiki 页面列表">
        <div class="we-side-actions">
          <button type="button" class="we-btn primary" id="newPageBtn">＋ 新建页面</button>
          <button type="button" class="we-btn" id="newSectionBtn">＋ 新建栏目</button>
        </div>
        <p class="we-repo" id="repoInfo"></p>
        <div class="we-nav" id="navList"></div>
        <p class="we-side-tip">图片只会写入 <code>/wiki/img/</code>，不会碰瓦片目录。保存只改仓库文件，部署完成后线上才生效。</p>
      </aside>

      <section class="we-card we-main" aria-label="编辑区">
        <div class="we-status" id="statusBar" role="status" aria-live="polite">
          <span class="we-status-dot" aria-hidden="true"></span>
          <span class="we-status-text">正在连接…</span>
        </div>

        <div id="welcomePane" class="we-welcome">
          <div class="we-welcome-mark" aria-hidden="true">✎</div>
          <h2>选择一个页面</h2>
          <p>从左侧列表选页面开始编辑，或者新建页面 / 栏目。所有改动都会提交到 GitHub，约 1–2 分钟后自动部署。</p>
          <div class="we-welcome-actions">
            <button type="button" class="we-btn primary" id="welcomeNewPage">新建页面</button>
            <a class="we-btn" href="/wiki/">查看线上 Wiki</a>
          </div>
        </div>

        <div id="editorPane" hidden>
          <div class="we-editor-head">
            <div class="we-file">
              <span class="we-file-path" id="filePath">—</span>
              <span class="we-badge" id="fileBadge">—</span>
            </div>
            <div class="we-toolbar">
              <button type="button" class="we-btn" id="uploadBtn">传图片</button>
              <button type="button" class="we-btn" id="refreshBtn">重新加载</button>
              <button type="button" class="we-btn danger" id="deleteBtn">删除</button>
              <button type="button" class="we-btn primary" id="saveBtn">保存</button>
            </div>
          </div>

          <div class="we-meta">
            <label class="we-field-inline">显示名
              <input type="text" id="labelInput" maxlength="60" autocomplete="off" />
            </label>
            <label class="we-field-inline">短名
              <input type="text" id="shortInput" maxlength="12" autocomplete="off" />
            </label>
            <button type="button" class="we-btn" id="saveMetaBtn">保存显示名</button>
            <span class="we-meta-hint" id="metaHint"></span>
          </div>

          <div class="we-split">
            <div class="we-pane">
              <div class="we-pane-head"><span>Markdown</span><span class="we-dirty" id="dirtyBadge" hidden>未保存</span></div>
              <textarea id="mdInput" spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="Markdown 内容" placeholder="在这里写 Markdown…"></textarea>
            </div>
            <div class="we-pane">
              <div class="we-pane-head"><span>预览</span><span class="we-pane-note">HTML 已转义，不会执行</span></div>
              <div class="we-preview" id="preview" aria-label="Markdown 预览"></div>
            </div>
          </div>
          <p class="we-footnote">支持标题、粗体、斜体、行内代码、代码块、链接、图片、无序 / 有序列表、引用、表格、分隔线。图片请用「传图片」上传，只会写入 /wiki/img/ 目录。</p>
        </div>
      </section>
    </div>

    <input type="file" id="imageInput" accept="image/*" hidden />

    <dialog id="pageDialog" class="we-dialog" aria-labelledby="pageDialogTitle">
      <form id="pageForm" novalidate>
        <header class="we-dialog-head">
          <span class="section-tag">NEW PAGE</span>
          <h2 id="pageDialogTitle">新建页面</h2>
          <p>文件会创建在 <code>web/src/pages/wiki/&lt;栏目&gt;/&lt;slug&gt;.md</code>，并加入导航。</p>
        </header>
        <p class="we-form-error" id="pageError" role="alert" hidden></p>
        <div class="we-form-field">
          <label for="npSection">所属栏目</label>
          <select id="npSection"></select>
        </div>
        <div class="we-form-field">
          <label for="npSlug">slug（文件名）</label>
          <div class="we-slug-row"><span id="npPrefix">—</span><input type="text" id="npSlug" maxlength="60" autocomplete="off" placeholder="例如 06-farm" /></div>
          <small>只能用小写字母、数字和连字符，必须以字母或数字开头。</small>
        </div>
        <div class="we-form-field">
          <label for="npTitle">标题</label>
          <input type="text" id="npTitle" maxlength="60" autocomplete="off" placeholder="例如：刷石机" />
        </div>
        <div class="we-form-field">
          <label for="npShort">短名（导航用，可空）</label>
          <input type="text" id="npShort" maxlength="12" autocomplete="off" placeholder="例如：刷石机" />
        </div>
        <div class="we-form-field">
          <label for="npDesc">描述（可空）</label>
          <input type="text" id="npDesc" maxlength="160" autocomplete="off" placeholder="一句话说明这页讲什么" />
        </div>
        <footer class="we-dialog-actions">
          <button type="button" class="we-btn" id="pageCancel">取消</button>
          <button type="submit" class="we-btn primary" id="pageCreate">创建页面</button>
        </footer>
      </form>
    </dialog>

    <dialog id="sectionDialog" class="we-dialog" aria-labelledby="sectionDialogTitle">
      <form id="sectionForm" novalidate>
        <header class="we-dialog-head">
          <span class="section-tag">NEW SECTION</span>
          <h2 id="sectionDialogTitle">新建栏目</h2>
          <p>会追加一个导航栏目，并创建 <code>&lt;key&gt;/index.md</code> 作为栏目首页（自动加入目录）。</p>
        </header>
        <p class="we-form-error" id="sectionError" role="alert" hidden></p>
        <div class="we-form-field">
          <label for="nsKey">key（目录名）</label>
          <input type="text" id="nsKey" maxlength="40" autocomplete="off" placeholder="例如 guide" />
          <small>只能用小写字母、数字和连字符；会用作目录名与导航 key。</small>
        </div>
        <div class="we-form-field">
          <label for="nsLabel">显示名</label>
          <input type="text" id="nsLabel" maxlength="40" autocomplete="off" placeholder="例如：进阶指南" />
        </div>
        <div class="we-form-field">
          <label for="nsTag">标签 tag（可空）</label>
          <input type="text" id="nsTag" maxlength="30" autocomplete="off" placeholder="例如 GUIDE，留空则用 key 大写" />
        </div>
        <footer class="we-dialog-actions">
          <button type="button" class="we-btn" id="sectionCancel">取消</button>
          <button type="submit" class="we-btn primary" id="sectionCreate">创建栏目</button>
        </footer>
      </form>
    </dialog>

    <noscript>
      <div class="we-card we-gate"><h2>需要启用 JavaScript</h2><p>Wiki 编辑器依赖浏览器脚本调用管理接口，请启用 JavaScript 后刷新。</p></div>
    </noscript>
  </div>

<style is:global>
  .wiki-editor [hidden]{display:none!important}
  .wiki-editor{max-width:1280px;margin:0 auto;padding:116px 20px 40px;color:var(--ink)}
  .wiki-editor h1,.wiki-editor h2,.wiki-editor h3,.wiki-editor p{margin-top:0}
  .wiki-editor .we-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;flex-wrap:wrap;margin:0 0 22px}
  .wiki-editor .we-head-copy{max-width:760px}
  .wiki-editor .we-head h1{font-size:clamp(30px,4vw,44px);line-height:1.2;margin:8px 0 10px}
  .wiki-editor .we-head p{margin:0;color:var(--muted);font-size:15.5px;line-height:1.8}
  .wiki-editor .we-back{flex:0 0 auto}
  .wiki-editor .we-card{background:var(--surface);border:1px solid var(--line);border-radius:26px;box-shadow:var(--shadow)}

  .wiki-editor .we-grid{display:grid;grid-template-columns:280px minmax(0,1fr);gap:18px;align-items:start}
  .wiki-editor .we-side{position:sticky;top:104px;max-height:calc(100dvh - 126px);display:flex;flex-direction:column;gap:12px;padding:16px;min-width:0}
  .wiki-editor .we-side-actions{display:grid;gap:8px}
  .wiki-editor .we-repo{margin:0;padding:0 4px;font-size:12px;line-height:1.6;color:var(--muted);word-break:break-all}
  .wiki-editor .we-repo:empty{display:none}
  .wiki-editor .we-nav{display:flex;flex-direction:column;gap:18px;overflow-y:auto;min-height:0;padding:2px 2px 4px;overscroll-behavior:contain}
  .wiki-editor .we-nav-group{display:flex;flex-direction:column;gap:2px;min-width:0}
  .wiki-editor .we-nav-title{display:flex;align-items:baseline;gap:8px;padding:0 12px 6px;font-size:12px;font-weight:700;letter-spacing:.08em;color:var(--ink);text-transform:uppercase}
  .wiki-editor .we-nav-title .we-nav-tag{font-style:normal;font-size:10px;font-weight:600;letter-spacing:.08em;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .wiki-editor .we-nav-item{display:block;width:100%;min-height:44px;padding:9px 12px;border:1px solid transparent;border-radius:14px;background:transparent;color:var(--muted);font-size:14.5px;line-height:1.45;text-align:left;word-break:break-word}
  .wiki-editor .we-nav-item:hover{background:var(--soft);color:var(--primary)}
  .wiki-editor .we-nav-item[aria-current]{background:var(--soft);border-color:var(--primary);color:var(--primary);font-weight:700}
  .wiki-editor .we-nav-item.orphan{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12.5px}
  .wiki-editor .we-nav-empty{margin:0;padding:4px 12px 6px;font-size:12.5px;line-height:1.6;color:var(--muted)}
  .wiki-editor .we-side-tip{margin:0;padding:12px 4px 0;border-top:1px solid var(--line);font-size:12px;line-height:1.7;color:var(--muted)}
  .wiki-editor .we-side-tip code{font-size:11.5px;background:var(--page);border-radius:6px;padding:1px 5px;word-break:break-all}

  .wiki-editor .we-main{padding:18px;min-width:0}
  .wiki-editor .we-status{display:flex;align-items:flex-start;gap:10px;flex-wrap:wrap;min-height:46px;padding:10px 14px;margin:0 0 16px;border:1px solid var(--line);border-radius:16px;background:var(--page);font-size:14px;line-height:1.65;color:var(--ink)}
  .wiki-editor .we-status-dot{flex:0 0 auto;width:9px;height:9px;margin-top:7px;border-radius:50%;background:var(--muted)}
  .wiki-editor .we-status.busy .we-status-dot{background:var(--primary);animation:we-pulse 1s ease-in-out infinite}
  .wiki-editor .we-status.ok .we-status-dot{background:#2f9e6f}
  .wiki-editor .we-status.warn .we-status-dot{background:#d99a2b}
  .wiki-editor .we-status.error .we-status-dot{background:#d9534f}
  .wiki-editor .we-status-text{flex:1 1 240px;min-width:0;overflow-wrap:anywhere}
  .wiki-editor .we-status-action{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 16px;border:1px solid var(--primary);border-radius:22px;background:var(--surface);color:var(--primary);font-size:13.5px;font-weight:700}
  .wiki-editor .we-status-action:hover{background:var(--soft)}
  @keyframes we-pulse{0%,100%{opacity:1}50%{opacity:.35}}

  .wiki-editor .we-welcome{padding:52px 20px 56px;text-align:center}
  .wiki-editor .we-welcome-mark{font-size:38px;color:var(--primary);line-height:1}
  .wiki-editor .we-welcome h2{font-size:24px;margin:14px 0 10px}
  .wiki-editor .we-welcome p{max-width:560px;margin:0 auto 20px;color:var(--muted);font-size:15px;line-height:1.8}
  .wiki-editor .we-welcome-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}

  .wiki-editor .we-editor-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin:0 0 12px}
  .wiki-editor .we-file{display:flex;align-items:center;gap:8px;min-width:0;flex-wrap:wrap}
  .wiki-editor .we-file-path{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px;line-height:1.5;color:var(--ink);background:var(--page);border:1px solid var(--line);border-radius:12px;padding:5px 10px;word-break:break-all}
  .wiki-editor .we-badge{flex:0 0 auto;font-size:11.5px;font-weight:700;letter-spacing:.06em;color:var(--primary);background:var(--soft);border-radius:14px;padding:4px 10px}
  .wiki-editor .we-badge.missing{color:#d9534f;background:transparent;border:1px solid currentColor}
  .wiki-editor .we-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}

  .wiki-editor .we-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 16px;border:1px solid var(--line);border-radius:24px;background:var(--surface);color:var(--ink);font-size:14px;font-weight:600;line-height:1.3;white-space:nowrap;text-align:center}
  .wiki-editor .we-btn:hover:not(:disabled){border-color:var(--primary);color:var(--primary)}
  .wiki-editor .we-btn.primary{background:var(--primary);border-color:var(--primary);color:var(--surface)}
  .wiki-editor .we-btn.primary:hover:not(:disabled){opacity:.9;color:var(--surface)}
  .wiki-editor .we-btn.danger{color:#d9534f}
  .wiki-editor .we-btn.danger:hover:not(:disabled){border-color:#d9534f;color:#d9534f}
  .wiki-editor .we-btn:disabled{opacity:.45;cursor:not-allowed}

  .wiki-editor .we-meta{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin:0 0 14px;padding:12px;border:1px solid var(--line);border-radius:18px;background:var(--page)}
  .wiki-editor .we-field-inline{display:flex;flex-direction:column;gap:4px;font-size:12px;font-weight:700;color:var(--muted);letter-spacing:.04em}
  .wiki-editor .we-field-inline input{min-height:44px;min-width:150px;padding:8px 12px;border:1px solid var(--line);border-radius:12px;background:var(--surface);color:var(--ink);font-size:14px;font-weight:400}
  .wiki-editor .we-meta .we-btn{margin-bottom:0}
  .wiki-editor .we-meta-hint{font-size:12.5px;line-height:1.6;color:var(--muted);padding-bottom:12px}

  .wiki-editor .we-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:14px}
  .wiki-editor .we-pane{display:flex;flex-direction:column;min-width:0}
  .wiki-editor .we-pane-head{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 2px 6px;font-size:12px;font-weight:700;letter-spacing:.06em;color:var(--muted)}
  .wiki-editor .we-pane-note{font-weight:400;letter-spacing:0;font-size:11.5px;color:var(--muted)}
  .wiki-editor .we-dirty{font-size:11.5px;font-weight:700;color:#d9534f;letter-spacing:0}
  .wiki-editor #mdInput{width:100%;height:min(60vh,560px);min-height:300px;resize:vertical;padding:14px 16px;border:1px solid var(--line);border-radius:18px;background:var(--page);color:var(--ink);font-family:ui-monospace,SFMono-Regular,Consolas,"Courier New",monospace;font-size:14px;line-height:1.7;tab-size:2}
  .wiki-editor #mdInput:disabled{opacity:.6}
  .wiki-editor .we-preview{height:min(60vh,560px);min-height:300px;overflow:auto;padding:16px 20px;border:1px solid var(--line);border-radius:18px;background:var(--page);font-size:15px;line-height:1.8;overflow-wrap:anywhere}
  .wiki-editor .we-preview>*:first-child{margin-top:0}
  .wiki-editor .we-preview h1{font-size:27px;line-height:1.3;margin:20px 0 12px}
  .wiki-editor .we-preview h2{font-size:22px;line-height:1.35;margin:22px 0 10px}
  .wiki-editor .we-preview h3{font-size:18px;line-height:1.4;margin:18px 0 8px}
  .wiki-editor .we-preview h4,.wiki-editor .we-preview h5,.wiki-editor .we-preview h6{font-size:15px;margin:14px 0 6px;color:var(--muted)}
  .wiki-editor .we-preview p{margin:0 0 12px}
  .wiki-editor .we-preview ul,.wiki-editor .we-preview ol{margin:0 0 14px;padding-left:22px}
  .wiki-editor .we-preview li{margin:4px 0}
  .wiki-editor .we-preview li::marker{color:var(--primary)}
  .wiki-editor .we-preview a{color:var(--primary);text-decoration:underline;text-underline-offset:3px}
  .wiki-editor .we-preview strong{font-weight:700}
  .wiki-editor .we-preview blockquote{margin:14px 0;padding:2px 0 2px 14px;border-left:3px solid var(--line);color:var(--muted)}
  .wiki-editor .we-preview code{background:var(--soft);border-radius:7px;padding:1px 6px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.9em}
  .wiki-editor .we-preview pre{margin:14px 0;padding:14px 16px;border:1px solid var(--line);border-radius:14px;background:var(--surface);overflow-x:auto}
  .wiki-editor .we-preview pre code{background:none;padding:0;white-space:pre;font-size:13px}
  .wiki-editor .we-preview hr{border:0;border-top:1px solid var(--line);margin:20px 0}
  .wiki-editor .we-preview img{max-width:100%;height:auto;border-radius:14px;border:1px solid var(--line)}
  .wiki-editor .we-table-wrap{margin:14px 0;overflow-x:auto}
  .wiki-editor .we-preview table{width:100%;border-collapse:collapse;font-size:14px;border:1px solid var(--line);border-radius:12px;overflow:hidden}
  .wiki-editor .we-preview th,.wiki-editor .we-preview td{padding:8px 12px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
  .wiki-editor .we-preview th{background:var(--soft);font-size:13px;white-space:nowrap}
  .wiki-editor .we-preview tr:last-child td{border-bottom:0}
  .wiki-editor .we-preview-empty{margin:0;color:var(--muted);font-size:13.5px}
  .wiki-editor .we-preview-note{margin:0 0 12px;padding:6px 10px;border:1px dashed var(--line);border-radius:10px;color:var(--muted);font-size:12px}
  .wiki-editor .we-footnote{margin:14px 2px 0;font-size:12.5px;line-height:1.7;color:var(--muted)}

  .wiki-editor .we-loading{display:flex;align-items:center;justify-content:center;gap:12px;padding:44px 20px;color:var(--muted);font-size:15px}
  .wiki-editor .we-loading p{margin:0}
  .wiki-editor .we-spinner{width:20px;height:20px;border:2px solid var(--line);border-top-color:var(--primary);border-radius:50%;animation:we-spin .8s linear infinite}
  @keyframes we-spin{to{transform:rotate(360deg)}}

  .wiki-editor .we-gate{padding:38px 28px;text-align:center}
  .wiki-editor .we-gate-mark{font-size:36px;line-height:1}
  .wiki-editor .we-gate h2{font-size:24px;margin:12px 0 8px}
  .wiki-editor .we-gate p{max-width:560px;margin:0 auto 20px;color:var(--muted);line-height:1.8;font-size:15px}
  .wiki-editor .we-gate-actions{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap}

  .wiki-editor .we-dialog{border:1px solid var(--line);border-radius:26px;background:var(--surface);color:var(--ink);padding:0;width:min(540px,calc(100vw - 32px));max-height:calc(100dvh - 40px);box-shadow:var(--shadow);overflow:auto}
  .wiki-editor .we-dialog::backdrop{background:#07101ccc;backdrop-filter:blur(6px)}
  .wiki-editor .we-dialog form{display:grid;gap:14px;padding:24px}
  .wiki-editor .we-dialog-head h2{font-size:24px;margin:6px 0 6px}
  .wiki-editor .we-dialog-head p{margin:0;color:var(--muted);font-size:13.5px;line-height:1.7}
  .wiki-editor .we-dialog-head code{font-size:12px;background:var(--page);border-radius:6px;padding:1px 5px;word-break:break-all}
  .wiki-editor .we-form-field{display:grid;gap:6px}
  .wiki-editor .we-form-field label{font-size:12.5px;font-weight:700;color:var(--muted);letter-spacing:.04em}
  .wiki-editor .we-form-field input,.wiki-editor .we-form-field select{width:100%;min-height:44px;padding:8px 12px;border:1px solid var(--line);border-radius:12px;background:var(--page);color:var(--ink);font-size:15px}
  .wiki-editor .we-form-field small{font-size:12px;line-height:1.6;color:var(--muted)}
  .wiki-editor .we-slug-row{display:flex;align-items:center;gap:0;border:1px solid var(--line);border-radius:12px;background:var(--page);padding-left:12px}
  .wiki-editor .we-slug-row span{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px;color:var(--muted);white-space:nowrap}
  .wiki-editor .we-slug-row input{border:0;background:transparent;border-radius:0;padding-left:4px}
  .wiki-editor .we-form-error{margin:0;padding:10px 12px;border:1px solid #d9534f;border-radius:12px;color:var(--ink);font-size:13px;line-height:1.6}
  .wiki-editor .we-dialog-actions{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;padding-top:4px}


  .tile-del { margin-top: 8px; min-height: 44px; border: 1px solid var(--line); border-radius: 20px; background: transparent; color: var(--err); font-size: 13px; font-weight: 700; }
  .tile-del:hover { border-color: var(--err); background: color-mix(in srgb, var(--err) 10%, transparent); }

  .tile-dialog { border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 26px; width: min(480px, 92vw); padding: 26px; box-shadow: var(--shadow); }
  .tile-dialog::backdrop { background: #07101cdd; backdrop-filter: blur(6px); }
  .tile-dialog h2 { font-size: 22px; margin: 0 0 10px; }
  .confirm-text { margin: 0 0 10px; }
  .confirm-note { margin: 0 0 18px; padding: 10px 14px; border-radius: 14px; background: var(--soft); font-size: 14px; color: var(--muted); }
  .confirm-error { margin: 0 0 12px; font-size: 14px; color: var(--err); }
  .confirm-actions { display: flex; justify-content: flex-end; gap: 12px; }
  .danger { background: var(--err); color: #fff; border: 0; border-radius: 22px; padding: 11px 22px; min-height: 44px; font-weight: 700; }

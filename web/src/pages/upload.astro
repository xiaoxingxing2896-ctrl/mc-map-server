  .tile-shot.is-broken::after { content: '缩略图加载失败'; position: absolute; inset: 0; display: grid; place-items: center; padding: 10px; text-align: center; font-size: 13px; color: var(--muted); }
  .tile-body { display: grid; gap: 3px; padding: 12px 13px 13px; }
  .tile-coord { font-size: 14px; font-weight: 700; }
  .tile-name { font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }

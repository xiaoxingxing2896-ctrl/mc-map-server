---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="上传瓦片">
  <div class="page-heading">
    <span class="section-tag">TILE UPLOAD</span>
    <h1>上传瓦片</h1>
    <p>仅管理员及以上权限可上传与删除。每张瓦片是 1024×1024 的 PNG，上传层优先于基础层显示，删除基础层不可恢复。</p>
  </div>
  <div class="content upload-page">
    <section class="card gate" id="gateSignin" hidden>
      <span class="section-tag">SIGN IN REQUIRED</span>
      <h2>请先登录</h2>
      <p class="gate-text" id="signinText">上传与删除瓦片需要登录。登录后会自动回到这个页面。</p>
      <p class="gate-actions">
        <a class="action" href="/account/?next=/upload/">前往账号入口登录 <span aria-hidden="true">↗</span></a>
      </p>
    </section>

    <section class="card gate" id="gateDenied" hidden>
      <span class="section-tag">READ ONLY</span>
      <h2>当前账号没有管理权限</h2>
      <p class="gate-text">已登录为 <strong id="deniedUser">—</strong>，角色 <span class="role-pill" id="deniedRole">user</span>。瓦片上传与删除仅对管理员（admin）与 Owner 开放，普通用户只能浏览地图。</p>
      <ul class="gate-list">
        <li>上传瓦片：仅 admin / owner</li>
        <li>删除瓦片：仅 admin / owner</li>
        <li>需要权限请联系服务器管理员。</li>
      </ul>
      <p class="gate-actions">
        <a class="action" href="/">返回地图 <span aria-hidden="true">↗</span></a>
        <a class="gate-link" href="/account/">切换账号</a>
      </p>
    </section>

    <section class="card gate" id="gateError" hidden>
      <span class="section-tag">CONNECTION</span>
      <h2>无法校验登录状态</h2>
      <p class="gate-text" id="gateErrorText">暂时无法连接服务器。</p>
      <p class="gate-actions">
        <button type="button" class="action" id="retryBtn">重试</button>
        <a class="gate-link" href="/account/?next=/upload/">前往账号入口</a>
      </p>
    </section>

    <p class="loading-line" id="gateLoading" role="status">正在校验登录状态…</p>

    <div id="console" class="stack" hidden>
      <section class="card toolbar" aria-label="瓦片管理台">
        <div class="world-tabs" role="group" aria-label="选择维度">
          <button type="button" class="world-btn" data-world="overworld" aria-pressed="true">主世界</button>
          <button type="button" class="world-btn" data-world="nether" aria-pressed="false">地狱</button>
          <button type="button" class="world-btn" data-world="end" aria-pressed="false">末地</button>
        </div>
        <div class="stats">
          <div class="stat"><span class="stat-num" id="statCount">0</span><span class="stat-label" id="statCountLabel">该维度瓦片数</span></div>
          <div class="stat"><span class="stat-num stat-user" id="statUser">—</span><span class="stat-label">当前用户</span></div>
          <div class="stat"><span class="role-pill" id="statRole">user</span><span class="stat-label">角色</span></div>
        </div>
      </section>

      <section class="card uploader" aria-labelledby="uploadTitle">
        <h2 id="uploadTitle">上传瓦片</h2>
        <p class="hint">选择 1024×1024、不超过 8 MB 的 PNG。文件名需带坐标，例如 x0_z0.png、x0z0.png 或 3_16_x0_z0.png；该坐标已有瓦片时自动改用替换。</p>
        <label class="dropzone" id="dropzone" for="tileFile">
          <span class="dropzone-icon" aria-hidden="true">⇪</span>
          <span class="dropzone-title">选择 PNG 文件</span>
          <span class="dropzone-hint">点击选择，或把文件拖到这里</span>
          <input type="file" id="tileFile" class="file-input" accept="image/png,.png" />
        </label>

        <div class="file-meta" id="fileMeta" hidden>
          <img id="fileThumb" class="file-thumb" alt="所选 PNG 的预览" />
          <div class="file-info">
            <p class="info-row"><span class="info-label">文件</span><span class="info-value" id="fileInfoName">—</span></p>
            <p class="info-row"><span class="info-label">体积</span><span class="info-value" id="fileInfoSize">—</span></p>
            <p class="info-row"><span class="info-label">尺寸</span><span class="info-value" id="fileInfoDim">—</span></p>
            <p class="info-row"><span class="info-label">坐标</span><span class="info-value" id="fileInfoCoords">—</span></p>
            <p class="info-row"><span class="info-label">方式</span><span class="info-value" id="fileInfoMode">—</span></p>
          </div>
        </div>

        <p class="up-status" id="upStatus" role="status" aria-live="polite"></p>

        <div class="up-actions" id="upActions" hidden>
          <button type="button" class="action" id="uploadBtn">开始上传 <span aria-hidden="true">↑</span></button>
          <button type="button" class="btn-secondary" id="clearBtn">清除</button>
        </div>
      </section>

      <section class="card" aria-labelledby="listTitle">
        <div class="list-head">
          <h2 id="listTitle">瓦片列表</h2>
          <div class="list-tools">
            <label class="search-label" for="tileSearch">按坐标搜索</label>
            <input type="search" id="tileSearch" placeholder="例如 x0 或 -512" autocomplete="off" />
            <button type="button" class="btn-secondary" id="refreshBtn">刷新</button>
          </div>
        </div>
        <p class="list-status" id="listStatus" role="status" aria-live="polite"></p>
        <div class="tile-grid" id="tileGrid"></div>
        <div class="empty" id="gridEmpty" hidden>
          <div class="empty-symbol" aria-hidden="true">▦</div>
          <p id="emptyText">这个维度还没有瓦片。</p>
        </div>
      </section>
    </div>

    <dialog class="tile-dialog" id="confirmDlg" aria-labelledby="confirmTitle">
      <h2 id="confirmTitle">确认删除瓦片</h2>
      <p class="confirm-text" id="confirmText"></p>
      <p class="confirm-note">上传层优先显示；删除基础层不可恢复。</p>
      <p class="confirm-error" id="confirmError" role="alert" hidden></p>
      <div class="confirm-actions">
        <button type="button" class="btn-secondary" id="confirmCancel">取消</button>
        <button type="button" class="danger" id="confirmOk">确认删除</button>
      </div>
    </dialog>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    'use strict';

    const TOKEN_KEY = 'mcmap_token';
    const WORLDS = { overworld: '主世界', nether: '地狱', end: '末地' };
    const MAX_BYTES = 8 * 1024 * 1024;
    const TILE_SIZE = 1024;
    const COORD_RE = /[xX](-?\d+)_?[zZ](-?\d+)\.png$/i;

    const el = (id) => document.getElementById(id);
    const state = { me: null, world: 'overworld', tiles: [], loading: false, filter: '', busy: false };
    let pending = null;
    let confirmTarget = null;

    function show(node, on) { if (node) node.hidden = !on; }

    function setGate(which, message) {
      show(el('gateLoading'), false);
      show(el('gateSignin'), which === 'signin');
      show(el('gateDenied'), which === 'denied');
      show(el('gateError'), which === 'error');
      show(el('console'), which === 'console');
      if (which === 'signin' && message) el('signinText').textContent = message;
      if (which === 'error' && message) el('gateErrorText').textContent = message;
    }

    function setStatus(node, text, kind) {
      if (!node) return;
      node.textContent = text || '';
      if (kind) node.dataset.kind = kind;
      else delete node.dataset.kind;
    }

    function readToken() { try { return localStorage.getItem(TOKEN_KEY) || ''; } catch { return ''; } }
    function clearToken() { try { localStorage.removeItem(TOKEN_KEY); } catch { /* 忽略 */ } }

    class ApiError extends Error {
      constructor(message, status) {
        super(message);
        this.name = 'ApiError';
        this.status = status;
      }
    }

    function fallbackMessage(status) {
      if (status === 401) return '登录状态已失效，请重新登录';
      if (status === 403) return '权限不足';
      if (status === 404) return '目标不存在或已被删除';
      if (status === 409) return '操作冲突，请刷新后重试';
      if (status === 413) return '文件超过大小限制';
      if (status === 415) return '请求格式不受支持';
      if (status === 0) return '网络错误，请检查连接后重试';
      return '请求失败（' + status + '）';
    }

    async function request(path, options) {
      const opts = options || {};
      const headers = new Headers(opts.headers || {});
      const token = readToken();
      if (token) headers.set('Authorization', 'Bearer ' + token);
      let response;
      try {
        response = await fetch(path, Object.assign({}, opts, { headers: headers }));
      } catch (error) {
        throw new ApiError(fallbackMessage(0), 0);
      }
      let data = null;
      const type = response.headers.get('content-type') || '';
      if (type.indexOf('application/json') !== -1) {
        try { data = await response.json(); } catch { data = null; }
      }
      if (!response.ok) {
        if (response.status === 401) clearToken();
        const serverMessage = data && typeof data.error === 'string' && data.error.trim();
        throw new ApiError(serverMessage || fallbackMessage(response.status), response.status);
      }
      return data;
    }

    function formatSize(bytes) {
      if (bytes >= 1024 * 1024) {
        const mb = bytes / (1024 * 1024);
        return (mb >= 10 ? Math.round(mb) : mb.toFixed(1)) + ' MB';
      }
      return Math.max(1, Math.round(bytes / 1024)) + ' KB';
    }

    function parseCoordinates(name) {
      const match = COORD_RE.exec(String(name || '').trim());
      if (!match) return null;
      const x = Number(match[1]);
      const z = Number(match[2]);
      if (!Number.isSafeInteger(x) || !Number.isSafeInteger(z)) return null;
      if (Math.abs(x) > 30000000 || Math.abs(z) > 30000000) return null;
      return { x: x, z: z };
    }

    function fileName(tile) {
      let value = String((tile && tile.url) || '');
      value = value.split('#')[0].split('?')[0];
      try { value = decodeURIComponent(value); } catch { /* 保留原样 */ }
      value = value.replace(/^[a-z]+:\/\/[^/]+/i, '');
      value = value.replace(/^\/tiles\//, '');
      value = value.replace(/^_uploads\/[^/]+\//, '');
      value = value.replace(/^(overworld|nether|end)\//, '');
      return value || ('x' + tile.x + '_z' + tile.z + '.png');
    }

    function matchesFilter(tile, query) {
      const q = String(query || '').trim().toLowerCase();
      if (!q) return true;
      const hay = ('x' + tile.x + ' z' + tile.z + ' x' + tile.x + '_z' + tile.z + ' ' + fileName(tile)).toLowerCase();
      return q.split(/[\s,，]+/).filter(Boolean).every((token) => hay.indexOf(token) !== -1);
    }

    function readImageSize(file) {
      return new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const image = new Image();
        image.onload = () => {
          const size = { width: image.naturalWidth, height: image.naturalHeight };
          URL.revokeObjectURL(url);
          resolve(size);
        };
        image.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error('无法读取图片，请确认这是有效的 PNG 文件。'));
        };
        image.src = url;
      });
    }

    // ---------- 渲染 ----------
    function buildTile(tile) {
      const card = document.createElement('article');
      card.className = 'tile';

      const shot = document.createElement('div');
      shot.className = 'tile-shot';
      const image = document.createElement('img');
      image.src = tile.url;
      image.alt = '';
      image.loading = 'lazy';
      image.decoding = 'async';
      image.addEventListener('error', () => shot.classList.add('is-broken'));
      shot.appendChild(image);

      const body = document.createElement('div');
      body.className = 'tile-body';

      const coord = document.createElement('span');
      coord.className = 'tile-coord';
      coord.textContent = 'x' + tile.x + ' · z' + tile.z;

      const name = document.createElement('span');
      name.className = 'tile-name';
      name.textContent = fileName(tile);

      const layer = document.createElement('span');
      layer.className = 'tile-layer';
      layer.textContent = tile.version ? '上传层' : '基础层';
      if (tile.version) layer.dataset.layer = 'upload';

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'tile-del';
      remove.textContent = '删除';
      remove.setAttribute('aria-label', '删除' + WORLDS[state.world] + '坐标 x' + tile.x + '、z' + tile.z + ' 的瓦片');
      remove.addEventListener('click', () => askDelete(tile));

      body.appendChild(coord);
      body.appendChild(name);
      body.appendChild(layer);
      body.appendChild(remove);
      card.appendChild(shot);
      card.appendChild(body);
      return card;
    }

    function render() {
      const grid = el('tileGrid');
      const list = state.tiles.filter((tile) => matchesFilter(tile, state.filter));
      grid.textContent = '';
      for (const tile of list) grid.appendChild(buildTile(tile));
      el('statCount').textContent = String(state.tiles.length);

      const empty = el('gridEmpty');
      if (state.loading) {
        show(empty, false);
        setStatus(el('listStatus'), '正在读取' + WORLDS[state.world] + '的瓦片列表…', 'busy');
        return;
      }
      if (!state.tiles.length) {
        el('emptyText').textContent = WORLDS[state.world] + '还没有瓦片，选择一张 PNG 就能上传第一张。';
        show(empty, true);
      } else if (!list.length) {
        el('emptyText').textContent = '没有匹配「' + state.filter + '」的坐标或文件名。';
        show(empty, true);
      } else {
        show(empty, false);
      }
      setStatus(el('listStatus'), state.filter
        ? '显示 ' + list.length + ' / ' + state.tiles.length + ' 张瓦片'
        : '共 ' + state.tiles.length + ' 张瓦片', '');
    }

    // ---------- 数据 ----------
    async function loadTiles() {
      if (!state.me) return;
      state.loading = true;
      state.tiles = [];
      render();
      try {
        const list = await request('/api/tiles?world=' + encodeURIComponent(state.world));
        state.tiles = Array.isArray(list) ? list.filter((tile) => tile && Number.isFinite(Number(tile.x)) && Number.isFinite(Number(tile.z))).map((tile) => ({
          x: Number(tile.x),
          z: Number(tile.z),
          url: String(tile.url || ''),
          version: typeof tile.version === 'string' ? tile.version : ''
        })) : [];
        state.loading = false;
        render();
        refreshPendingMode();
      } catch (error) {
        state.loading = false;
        render();
        if (error.status === 401) {
          setGate('signin', '登录状态已失效，请重新登录后再进入管理台。');
          return;
        }
        setStatus(el('listStatus'), '读取瓦片列表失败：' + error.message, 'err');
      }
    }

    async function setWorld(world) {
      if (!WORLDS[world] || state.busy) return;
      state.world = world;
      state.filter = '';
      el('tileSearch').value = '';
      el('statCountLabel').textContent = WORLDS[world] + '瓦片数';
      document.querySelectorAll('.world-btn').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.world === world));
      });
      clearPending(false);
      await loadTiles();
    }

    // ---------- 上传 ----------
    function clearPending(keepStatus) {
      if (pending && pending.thumb) URL.revokeObjectURL(pending.thumb);
      pending = null;
      const input = el('tileFile');
      if (input) input.value = '';
      show(el('fileMeta'), false);
      show(el('upActions'), false);
      const thumb = el('fileThumb');
      if (thumb) thumb.removeAttribute('src');
      el('dropzone').classList.remove('is-over');
      if (!keepStatus) setStatus(el('upStatus'), '', '');
    }

    function refreshPendingMode() {
      if (!pending) return;
      const existing = state.tiles.find((tile) => tile.x === pending.x && tile.z === pending.z);
      pending.mode = existing ? 'replace' : 'add';
      pending.version = existing && existing.version ? existing.version : '';
      const mode = el('fileInfoMode');
      if (mode) mode.textContent = existing ? (pending.version ? '替换（上传层）' : '替换（基础层）') : '新增';
    }

    async function handleFile(file) {
      const status = el('upStatus');
      if (!file) {
        clearPending(false);
        return;
      }
      clearPending(true);
      const isPng = file.type === 'image/png' || /\.png$/i.test(file.name || '');
      if (!isPng) {
        setStatus(status, '请选择 PNG 文件（当前为 ' + (file.name || file.type || '未知类型') + '）。', 'err');
        return;
      }
      if (!file.size) {
        setStatus(status, '文件是空的，请重新导出瓦片。', 'err');
        return;
      }
      if (file.size > MAX_BYTES) {
        setStatus(status, '文件 ' + formatSize(file.size) + '，超过 8 MB 上限。', 'err');
        return;
      }
      setStatus(status, '正在读取图片尺寸…', 'busy');
      let size;
      try {
        size = await readImageSize(file);
      } catch (error) {
        setStatus(status, error.message, 'err');
        return;
      }
      if (size.width !== TILE_SIZE || size.height !== TILE_SIZE) {
        setStatus(status, '需要 ' + TILE_SIZE + '×' + TILE_SIZE + ' 的 PNG，当前为 ' + size.width + '×' + size.height + '。', 'err');
        return;
      }
      const coords = parseCoordinates(file.name);
      if (!coords) {
        setStatus(status, '无法从文件名解析坐标。请命名为 x0_z0.png、x0z0.png 或 3_16_x0_z0.png。', 'err');
        return;
      }
      const existing = state.tiles.find((tile) => tile.x === coords.x && tile.z === coords.z);
      const thumb = URL.createObjectURL(file);
      pending = {
        file: file,
        x: coords.x,
        z: coords.z,
        width: size.width,
        height: size.height,
        mode: existing ? 'replace' : 'add',
        version: existing && existing.version ? existing.version : '',
        thumb: thumb
      };
      el('fileThumb').src = thumb;
      el('fileInfoName').textContent = file.name;
      el('fileInfoSize').textContent = formatSize(file.size);
      el('fileInfoDim').textContent = size.width + ' × ' + size.height;
      el('fileInfoCoords').textContent = 'x' + coords.x + '、z' + coords.z;
      el('fileInfoMode').textContent = existing ? (pending.version ? '替换（上传层）' : '替换（基础层）') : '新增';
      show(el('fileMeta'), true);
      show(el('upActions'), true);
      const where = '坐标 x' + coords.x + '、z' + coords.z + ' 就绪：';
      setStatus(status, existing
        ? (pending.version
          ? where + '该坐标已有上传层瓦片，将以替换方式提交；期间被他人更新会提示版本冲突。'
          : where + '该坐标已有基础层瓦片，上传后会以覆盖层显示。')
        : where + '该坐标暂无瓦片，将以新增方式提交。', 'ok');
    }

    function uploadErrorMessage(error, job) {
      if (error.status === 403) return '权限不足：仅管理员或 Owner 可上传瓦片（' + error.message + '）。';
      if (error.status === 409) {
        return job.mode === 'replace'
          ? '版本冲突：这张上传层瓦片已被他人更新，列表已刷新，请重新选择文件后再提交。'
          : '该坐标已有瓦片，列表已刷新，请重新选择文件以替换。';
      }
      if (error.status === 413) return '瓦片不能超过 8 MB。';
      if (error.status === 415) return '请求体必须是 image/png，请重新选择 PNG 文件。';
      if (error.status === 400) return '瓦片校验失败：' + error.message;
      if (error.status === 404) return '目标坐标不存在，请刷新列表后重试。';
      return '上传失败：' + error.message;
    }

    async function startUpload() {
      if (!pending || state.busy) return;
      const job = pending;
      const status = el('upStatus');
      const button = el('uploadBtn');
      state.busy = true;
      button.disabled = true;
      setStatus(status, (job.mode === 'replace' ? '正在替换' : '正在上传') + ' x' + job.x + '、z' + job.z + '…', 'busy');
      const name = 'x' + job.x + '_z' + job.z + '.png';
      const query = '?world=' + encodeURIComponent(state.world) + '&name=' + encodeURIComponent(name) + '&mode=' + job.mode;
      const headers = { 'Content-Type': 'image/png' };
      if (job.mode === 'replace' && job.version) headers['If-Match'] = job.version;
      try {
        await request('/api/tiles' + query, { method: 'PUT', body: job.file, headers: headers });
        clearPending(true);
        await loadTiles();
        setStatus(status, (job.mode === 'replace' ? '已替换 ' : '已上传 ') + WORLDS[state.world] + '坐标 x' + job.x + '、z' + job.z + '，列表已刷新。', 'ok');
      } catch (error) {
        if (error.status === 401) {
          clearPending(true);
          setGate('signin', '登录状态已失效，请重新登录后再上传。');
          return;
        }
        if (error.status === 409) await loadTiles();
        setStatus(status, uploadErrorMessage(error, job), 'err');
      } finally {
        state.busy = false;
        button.disabled = false;
      }
    }

    // ---------- 删除 ----------
    function closeDialog() {
      const dialog = el('confirmDlg');
      try { if (dialog.open) dialog.close(); } catch { /* 忽略 */ }
      confirmTarget = null;
    }

    function askDelete(tile) {
      confirmTarget = tile;
      const dialog = el('confirmDlg');
      const text = '将删除' + WORLDS[state.world] + '坐标 x' + tile.x + '、z' + tile.z + ' 的瓦片（' + fileName(tile) + '，' + (tile.version ? '上传层' : '基础层') + '）。';
      el('confirmText').textContent = text;
      el('confirmError').textContent = '';
      el('confirmError').hidden = true;
      el('confirmOk').disabled = false;
      el('confirmOk').textContent = '确认删除';
      if (typeof dialog.showModal !== 'function') {
        if (window.confirm(text + ' 上传层优先显示；删除基础层不可恢复。')) submitDelete();
        return;
      }
      dialog.showModal();
      el('confirmCancel').focus();
    }

    async function submitDelete() {
      if (!confirmTarget || state.busy) return;
      const tile = confirmTarget;
      const name = fileName(tile);
      const okButton = el('confirmOk');
      const errorBox = el('confirmError');
      state.busy = true;
      okButton.disabled = true;
      okButton.textContent = '删除中…';
      errorBox.hidden = true;
      errorBox.textContent = '';
      try {
        const result = await request('/api/tiles?world=' + encodeURIComponent(state.world) + '&name=' + encodeURIComponent(name), { method: 'DELETE' });
        const layer = result && result.removed === 'upload' ? '上传层' : (result && result.removed === 'base' ? '基础层' : '');
        const message = '已删除 ' + WORLDS[state.world] + '坐标 x' + tile.x + '、z' + tile.z + ' 的瓦片' + (layer ? '（' + layer + '）' : '') + '。';
        closeDialog();
        await loadTiles();
        setStatus(el('listStatus'), message, 'ok');
      } catch (error) {
        if (error.status === 401) {
          closeDialog();
          setGate('signin', '登录状态已失效，请重新登录后再删除。');
          return;
        }
        errorBox.textContent = error.status === 403
          ? '权限不足：仅管理员或 Owner 可删除瓦片。'
          : '删除失败：' + error.message;
        errorBox.hidden = false;
        if (error.status === 404) await loadTiles();
      } finally {
        state.busy = false;
        okButton.disabled = false;
        okButton.textContent = '确认删除';
        confirmTarget = null;
      }
    }

    // ---------- 启动 ----------
    async function boot() {
      setGate('loading');
      show(el('gateLoading'), true);
      if (!readToken()) {
        setGate('signin', '上传与删除瓦片需要登录。登录后会自动回到这个页面。');
        return;
      }
      el('gateLoading').textContent = '正在校验登录状态…';
      let me;
      try {
        me = await request('/api/me');
      } catch (error) {
        if (error.status === 401 || error.status === 403) {
          setGate('signin', '登录状态已失效，请重新登录后再进入管理台。');
          return;
        }
        setGate('error', error.message || '无法连接服务器，请稍后重试。');
        return;
      }
      state.me = me;
      el('statUser').textContent = me.username || '—';
      el('statRole').textContent = me.role || 'user';
      if (me.role !== 'admin' && me.role !== 'owner') {
        el('deniedUser').textContent = me.username || '（未知用户）';
        el('deniedRole').textContent = me.role || 'user';
        setGate('denied');
        return;
      }
      setGate('console');
      el('statCountLabel').textContent = WORLDS[state.world] + '瓦片数';
      await loadTiles();
    }

    // ---------- 事件 ----------
    document.querySelectorAll('.world-btn').forEach((button) => {
      button.addEventListener('click', () => setWorld(button.dataset.world));
    });
    el('tileFile').addEventListener('change', (event) => handleFile(event.target.files && event.target.files[0]));
    el('uploadBtn').addEventListener('click', startUpload);
    el('clearBtn').addEventListener('click', () => { clearPending(false); setStatus(el('upStatus'), '已清除所选文件。', ''); });
    el('refreshBtn').addEventListener('click', loadTiles);
    el('tileSearch').addEventListener('input', (event) => {
      state.filter = event.target.value;
      render();
    });
    el('retryBtn').addEventListener('click', boot);
    el('confirmCancel').addEventListener('click', closeDialog);
    el('confirmOk').addEventListener('click', submitDelete);
    el('confirmDlg').addEventListener('close', () => { confirmTarget = null; });
    el('confirmDlg').addEventListener('cancel', () => { confirmTarget = null; });

    const dropzone = el('dropzone');
    dropzone.addEventListener('dragover', (event) => {
      event.preventDefault();
      dropzone.classList.add('is-over');
    });
    dropzone.addEventListener('dragleave', () => dropzone.classList.remove('is-over'));
    dropzone.addEventListener('drop', (event) => {
      event.preventDefault();
      dropzone.classList.remove('is-over');
      const file = event.dataTransfer && event.dataTransfer.files && event.dataTransfer.files[0];
      if (file) {
        el('tileFile').value = '';
        handleFile(file);
      }
    });

    boot();
  })();
</script>

<style>
  .upload-page [hidden] { display: none !important; }
  .loading-line { color: var(--muted); margin: 0 0 18px; font-size: 15px; }
  .gate h2 { font-size: 24px; margin: 8px 0 10px; }
  .gate-text { margin: 0 0 16px; }
  .gate-list { margin: 0 0 18px; padding-left: 20px; color: var(--muted); }
  .gate-list li { margin-bottom: 4px; }
  .gate-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin: 0; }
  .gate-link { color: var(--primary); font-weight: 600; }
  .role-pill { justify-self: start; background: var(--soft); color: var(--primary); border-radius: 20px; padding: 2px 12px; font-size: 14px; font-weight: 700; }

  .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; padding: 20px 24px; }
  .world-tabs { display: flex; gap: 6px; background: var(--soft); border-radius: 24px; padding: 5px; }
  .world-btn { border: 0; background: transparent; color: var(--muted); border-radius: 20px; padding: 9px 18px; min-height: 44px; font-size: 15px; font-weight: 700; }
  .world-btn:hover { color: var(--primary); }
  .world-btn[aria-pressed="true"] { background: var(--surface); color: var(--primary); box-shadow: var(--shadow); }
  .stats { display: flex; gap: 26px; flex-wrap: wrap; }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat-num { font-size: 20px; font-weight: 800; line-height: 1.3; }
  .stat-user { font-size: 16px; overflow-wrap: anywhere; max-width: 220px; }
  .stat-label { font-size: 13px; color: var(--muted); }

  .uploader h2 { font-size: 22px; margin: 0 0 8px; }
  .hint { margin: 0 0 18px; font-size: 15px; }
  .dropzone { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; text-align: center; min-height: 168px; padding: 24px; border: 2px dashed var(--line); border-radius: 22px; background: color-mix(in srgb, var(--soft) 45%, transparent); cursor: pointer; }
  .dropzone:hover, .dropzone.is-over { border-color: var(--primary); background: var(--soft); }
  .dropzone:focus-within { border-color: var(--primary); outline: 3px solid var(--primary); outline-offset: 3px; }
  .dropzone-icon { font-size: 30px; line-height: 1; color: var(--primary); }
  .dropzone-title { font-weight: 700; font-size: 16px; }
  .dropzone-hint { color: var(--muted); font-size: 14px; }
  .file-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }

  .file-meta { display: flex; align-items: center; gap: 16px; margin: 16px 0 0; padding: 14px; border: 1px solid var(--line); border-radius: 18px; }
  .file-thumb { width: 64px; height: 64px; flex-shrink: 0; border-radius: 12px; object-fit: cover; background: var(--soft); }
  .file-info { display: grid; gap: 3px; margin: 0; min-width: 0; }
  .info-row { display: flex; gap: 10px; margin: 0; font-size: 14px; min-width: 0; }
  .info-label { color: var(--muted); flex-shrink: 0; min-width: 42px; }
  .info-value { overflow-wrap: anywhere; }

  .up-status { margin: 14px 0 0; min-height: 22px; font-size: 14px; color: var(--muted); }
  .up-status[data-kind="ok"] { color: var(--ok); }
  .up-status[data-kind="err"] { color: var(--err); }
  .up-status[data-kind="busy"]::before { content: '◌'; display: inline-block; margin-right: 6px; animation: tile-spin 1.1s linear infinite; }
  .up-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 16px 0 0; }
  .btn-secondary { background: var(--soft); color: var(--ink); border: 1px solid var(--line); border-radius: 20px; padding: 10px 18px; min-height: 44px; font-size: 14px; font-weight: 600; }
  .btn-secondary:hover { border-color: var(--primary); color: var(--primary); }
  button:disabled { opacity: 0.55; cursor: not-allowed; }
  @keyframes tile-spin { to { transform: rotate(360deg); } }

  .list-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 6px; }
  .list-head h2 { font-size: 22px; margin: 0; }
  .list-tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .search-label { font-size: 13px; color: var(--muted); }
  .list-tools input[type="search"] { min-height: 44px; min-width: 170px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); font-size: 14px; }
  .list-tools input[type="search"]:focus { border-color: var(--primary); }
  .list-status { margin: 0 0 4px; min-height: 22px; font-size: 14px; color: var(--muted); }
  .list-status[data-kind="ok"] { color: var(--ok); }
  .list-status[data-kind="err"] { color: var(--err); }
  .list-status[data-kind="busy"]::before { content: '◌'; display: inline-block; margin-right: 6px; animation: tile-spin 1.1s linear infinite; }

  .tile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; margin-top: 14px; }
  .tile { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--surface); }
  .tile-shot { position: relative; aspect-ratio: 1 / 1; background: var(--soft); }

    .confirm-actions { flex-direction: column-reverse; }
    .confirm-actions > * { width: 100%; }
  }
</style>

<style is:global>
  .upload-page { --ok: #1a7f37; --err: #cf222e; }
  :root[data-theme="dark"] .upload-page { --ok: #3fb950; --err: #ff7b72; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .upload-page { --ok: #3fb950; --err: #ff7b72; }
  }
</style>

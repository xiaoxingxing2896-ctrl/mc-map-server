---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';

type Person = { name: string; contribution: string };
const people = site.thanks as Person[];

// 中文姓名无法在运行时可靠地推导拼音首字母，新增成员时请在这里补充首字母。
const initials: Record<string, string> = {
  '阿菜': 'A',
  '白风': 'B',
  '冰原盾羊': 'B',
  '不吃药': 'B',
  'bcs': 'B',
  'BKNooccar': 'B',
  '初羽': 'C',
  '黛尼': 'D',
  'hmjaa': 'H',
  '开元': 'K',
  'TYF': 'T',
  'var': 'V',
  '肖': 'X'
};
const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('');
const groups = alphabet
  .map((letter) => ({ letter, people: people.filter((person) => initials[person.name] === letter) }))
  .filter((group) => group.people.length > 0);

const projects = [
  ['01','mc-map-server','xiaoxingxing2896-ctrl','地图、标注与账号系统。','https://github.com/xiaoxingxing2896-ctrl/mc-map-server'],
  ['02','RyuChan','kobaridev','网站主体设计与 Astro 模板基础。','https://github.com/kobaridev/RyuChan'],
  ['03','Wan’s Mcweb','wanwanjiean123','历程时间轴设计、图片命名方式与介绍页风景素材。','https://github.com/wanwanjiean123/Wan-s-Mcweb']
];
---
<BaseLayout title="特别鸣谢">
  <div class="page-heading">
    <span class="section-tag">MADE POSSIBLE BY YOU</span>
    <h1>感谢，每一个你。</h1>
    <p>感谢为这个世界投入时间与心意的伙伴，也感谢开源社区让这些想法成为可能。</p>
  </div>
  <div class="content stack">
    <p class="thanks-note">以下名单按姓名首字母排序，不分先后与贡献大小。</p>
    <article class="card thanks-board">
      {groups.map((group) => (
        <div class="thanks-row">
          <h2 class="thanks-letter">{group.letter}</h2>
          <div class="authors thanks-names">
            {group.people.map((person) => <span>{person.name}</span>)}
          </div>
        </div>
      ))}
    </article>
    <h2 class="thanks-subtitle">开源项目</h2>
    <div class="credits">
      {projects.map(([number, name, author, description, url]) => (
        <article class="card">
          <span class="credit-number">OPEN SOURCE / {number}</span>
          <h2>{name}</h2>
          <p>{description}</p>
          <a href={url} target="_blank" rel="noopener noreferrer">{author} ↗</a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .thanks-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
  }
  .thanks-note:before {
    content: '';
    width: 4px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 2px;
    background: var(--primary);
  }
  .card.thanks-board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 0;
    padding: 6px 26px;
  }
  .thanks-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 8px 14px 0;
    min-height: 52px;
  }
  .thanks-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    margin: 0;
    border-radius: 12px;
    background: var(--soft);
    color: var(--primary);
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
  }
  .thanks-names.authors {
    gap: 8px;
  }
  .thanks-names.authors span {
    padding: 4px 13px;
    font-size: 15px;
  }
  .thanks-subtitle {
    margin: 26px 0 0;
  }
  @media (max-width: 850px) {
    .card.thanks-board {
      padding: 4px 18px;
      grid-template-columns: 1fr;
    }
    .thanks-row {
      gap: 12px;
      padding: 14px 0;
    }
  }
</style>
